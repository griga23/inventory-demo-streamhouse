# Shape of config/local.env, which `terraform apply` (in terraform/) generates for
# you automatically - see terraform/outputs.tf and terraform/templates/local.env.tpl.
# You normally never need to create or edit local.env by hand; this file exists so
# the expected shape is documented and version-controlled.

# --- Identifiers ---
ENV_ID=env-xxxxxx
KAFKA_CLUSTER_ID=lkc-xxxxxx
SCHEMA_REGISTRY_CLUSTER_ID=lsrc-xxxxxx
CLOUD_PROVIDER=AWS
CLOUD_REGION=us-west-2

# --- Kafka client (used by the storefront app to publish item_purchased events) ---
BOOTSTRAP_SERVERS=pkc-xxxxxx.us-west-2.aws.confluent.cloud:9092
KAFKA_API_KEY=
KAFKA_API_SECRET=

# --- Schema Registry (item_purchased's JSON schema is registered here by Terraform) ---
SCHEMA_REGISTRY_URL=https://psrc-xxxxxx.us-west-2.aws.confluent.cloud
SCHEMA_REGISTRY_API_KEY=
SCHEMA_REGISTRY_API_SECRET=

# --- Topic names (must match flink-sql/*.sql and terraform/variables.tf) ---
TOPIC_ITEM_ADDED_TO_STOCK=item_added_to_stock
TOPIC_ITEM_PURCHASED=item_purchased
TOPIC_CURRENT_INVENTORY=current_inventory

# --- CUT 3/4: service account Terraform grants DeveloperRead so the storefront app
# can query current_inventory via the Lightning Query API ---
STOREFRONT_PRINCIPAL_ID=

# --- CUT 4: Global API key for the Lightning Query API (Terraform-created) ---
LIGHTNING_API_KEY=
LIGHTNING_API_SECRET=
